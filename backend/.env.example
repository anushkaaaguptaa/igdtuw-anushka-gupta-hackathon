# RiskLens AI Backend Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection (SQLite local file)
DATABASE_URL=sqlite:///./risklens.db

# NLP Inference Mode ('neural_live' for FinBERT or 'lexicon_fallback' for offline rule-based)
INFERENCE_MODE=neural_live

# Ingestion External Providers
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
INGESTION_REQUEST_TIMEOUT=12.0

# Stress Testing & Monte Carlo Calibration
DEFAULT_VAR_SIMULATION_DRAWS=1000
AUTO_TRIGGER_IMPACT_THRESHOLD=7
ENABLE_AUTO_STRESS_TEST=true
